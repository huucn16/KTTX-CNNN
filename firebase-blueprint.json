          "minLength": 1,
          "maxLength": 200
        },
        "studentName": {
          "type": "string",
          "description": "Họ và tên học sinh",
          "minLength": 1,
          "maxLength": 100
        },
        "studentClass": {
          "type": "string",
          "description": "Lớp của học sinh",
          "minLength": 1,
          "maxLength": 30
        },
        "mode": {
          "type": "string",
          "description": "Chế độ làm bài",
          "enum": ["timed", "practice"]
        },
        "grade": {
          "type": "string",
