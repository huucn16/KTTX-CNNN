        "startedAt": {
          "type": "string",
          "description": "Thời điểm bắt đầu làm bài (ISO 8601)",
          "minLength": 10,
          "maxLength": 40
        },
        "completedAt": {
          "type": "string",
          "description": "Thời điểm nộp bài (ISO 8601)",
          "minLength": 10,
          "maxLength": 40
        },
        "durationUsedSeconds": {
          "type": "number",
          "description": "Thời gian làm bài thực tế tính bằng giây"
        },
        "durationLimitSeconds": {
          "type": "number",
