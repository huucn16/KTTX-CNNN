          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Dấu thời gian máy chủ lúc lưu trữ bài thi"
        }
      },
      "required": [
        "id",
        "title",
        "studentName",
        "studentClass",
        "mode",
        "grade",
        "topicIds",
        "startedAt",
        "completedAt",
        "durationUsedSeconds",
        "durationLimitSeconds",
        "questionIds",
        "selectedIndices",
        "flaggedIds",
        "correctCount",
        "totalCount",
        "score10",
        "leaveWarnings",
        "submitReason",
        "savedByUid",
        "savedAt"
      ]
    },
    "IssuedAccount": {
      "title": "IssuedAccount",
      "description": "Hồ sơ tài khoản đăng nhập do quản trị viên cấp cho giáo viên hoặc học sinh (không lưu mật khẩu)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID Firebase Auth của tài khoản được cấp",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Tên đăng nhập hoặc định danh tài khoản",
          "minLength": 2,
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "description": "Email đăng nhập Firebase Auth tương ứng",
          "minLength": 5,
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "description": "Họ và tên hiển thị của người dùng",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Vai trò được cấp",
          "enum": ["student", "teacher"]
        },
        "studentClass": {
          "type": "string",
          "description": "Lớp học của học sinh (để trống nếu là giáo viên)",
          "maxLength": 30
        },
        "active": {
          "type": "boolean",
          "description": "Trạng thái kích hoạt tài khoản"
        },
        "createdByUid": {
          "type": "string",
          "description": "UID của quản trị viên cấp tài khoản",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm cấp tài khoản"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm cập nhật gần nhất"
        }
      },
      "required": [
        "uid",
        "username",
        "email",
        "displayName",
        "role",
        "studentClass",
        "active",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Kho lưu trữ bài nộp và điểm số của học sinh đồng bộ về thẻ Bảng điểm"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Tài khoản giáo viên/quản trị viên được phép đọc và quản lý bảng điểm"
    },
    "/examControl/{controlId}": {
      "schema": { "$ref": "#/entities/ExamControl" },
      "description": "Trạng thái kết thúc hoặc mở lại bài thi từ thẻ Bảng điểm"
    },
    "/savedExams/{savedExamId}": {
      "schema": { "$ref": "#/entities/SavedExam" },
      "description": "Kho bài thi hoàn chỉnh của học sinh được lưu trữ lâu dài từ thẻ Bảng điểm"
    },
    "/issuedAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/IssuedAccount" },
      "description": "Danh sách tài khoản đăng nhập do quản trị viên cấp phát và quản lý trạng thái"
    }
  }
}
