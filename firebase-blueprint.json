          "description": "Số lần cảnh báo thoát màn hình khi kiểm tra"
        },
        "submitReason": {
          "type": "string",
          "description": "Hình thức nộp bài",
          "enum": ["manual", "timeout", "auto-leave", "teacher-ended"]
        },
        "savedByUid": {
          "type": "string",
          "description": "UID giáo viên thực hiện lưu bài thi",
          "minLength": 1,
